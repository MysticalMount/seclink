package api

import (
	"seclink/db"
	"fmt"
	"strconv"
	"github.com/spf13/viper"
)

templ AdminLayout() {
	<!doctype html>
	<html lang="en" data-bs-theme="dark">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Seclink</title>
		<link href="/static/bootstrap.min.css" rel="stylesheet">
	</head>
	<script src="/static/bootstrap.bundle.min.js"></script>
	<script src="/static/htmx.min.js"></script>
	<script src="/static/json-enc.js"></script>
	<body>
		<h3>
			Seclink
			<small class="text-muted">Secure sharing of time based links</small>
		</h3>
		{ children... }
	</body>
	</html>
}

templ AdminLinksTable(links []db.GetAllLinksRow) {
	<h4>Active links</h4>
	<table class="table">
	<thead>
		<tr>
		<th>Page</th>
		<th>Expires</th>
		<th>Link</th>
		</tr>
	</thead>
	<tbody>
	for _, link := range links {
		{{ linkUrl := fmt.Sprintf("%s/links/%s", viper.GetString("server.externalurl"), link.Link.ID) }}
		<tr>
		<td>{ link.Link.PostName }</td>
		<td>{{ strExpires := strconv.FormatInt(link.Link.Expires, 10)}}{ strExpires }</td>
		<td><a href={ templ.URL(linkUrl) }>{ linkUrl }</a></td>
		</tr>
	}
	</tbody> 
	</table>
}

templ AdminPostTable(posts []db.Post) {
	<h4>Files</h4>
	<table class="table">
	<thead>
		<tr>
		<th>Name</th>
		<th>Path</th>
		<th></th>
		<th></th>
		<th></th>
		</tr>
	</thead>
	<tbody>
	for index, post := range posts {
		<tr>
		<td><input type="hidden" class={ fmt.Sprintf("row%d-input", index) } name="post_name" value={ post.Name }/>{ post.Name }</td>
		<td>{ post.Path }</td>
		<td><input type="text" class={ fmt.Sprintf("row%d-input", index) } name="ttl" value="24h"/></td>
		<td><button hx-post="/api/v1/links/share"  hx-target="#linksTable" hx-include={ fmt.Sprintf(".row%d-input", index) } hx-ext="json-enc">Share</button></td>
		<td>Delete</td>
		</tr>
	}
	</tbody>
	</table>
}

templ AdminUploadFileForm() {
	<h4>Upload file</h4>
	<form id="binaryForm" enctype="multipart/form-data">
	<input type="file" name="binaryFile">
	<button hx-post="/api/v1/files/upload" hx-include="[name='binaryFile']" hx-encoding="multipart/form-data" hx-target="#fileTable">Upload</button>
	</form>
}

templ AdminUploadPageForm() {
	<h4>Upload page</h4>
	<form id="binaryForm" enctype="multipart/form-data">
	<input type="file" name="binaryFile">
	<button hx-post="/api/v1/pages/upload" hx-include="[name='binaryFile']" hx-encoding="multipart/form-data" hx-target="#pageTable">Upload</button>
	</form>
}


templ AdminUiPage(links []db.GetAllLinksRow, posts []db.Post) {
	@AdminLayout() {
		<div id="linksTable">
		@AdminLinksTable(links)
		</div>
		<div id="pageTable">
		@AdminPostTable(posts)
		</div>
		@AdminUploadPageForm()
	}
}

templ PageLayout(page Page, glr db.GetLinkRow) {
	<!DOCTYPE html>
	<html lang="en">
	{{ base := fmt.Sprintf("/links/%s/", glr.Link.ID) }}
	<base href={ base }>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="description" content={ page.MetaDescription }>
		<meta property="og:title" content={ page.MetaPropertyTitle }>
		<meta property="og:description" content={ page.MetaPropertyDescription }>
		<title>{ page.Title }</title>
		<link rel="stylesheet" href="/static/css/style.css">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">
		<script defer src="/static/fontawesome-free-6.4.2-web/js/solid.js"></script>
		<script defer src="/static/fontawesome-free-6.4.2-web/js/fontawesome.js"></script>
	</head>
	<body>
		{ children... }
	</body>
	<footer>
		<div id="footer">
			<br />
			<br />
			<hr />
			<p>Seclink is a project by MysticalMount</p>
		</div>
	</footer>
	</html>
}


templ RenderPage(page Page, glr db.GetLinkRow) {
	@PageLayout(page, glr) {
		<div class="container">
			<main class="main-content">
				<h1>{ page.Title }</h1>
				<p class="description">{ page.Description }</p>
				<hr />
				@templ.Raw(page.Content)
			</main>
		</div>
	}
}